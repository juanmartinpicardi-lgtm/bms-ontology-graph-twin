# Copy to .streamlit/secrets.toml (kept out of git) and fill in. Used by the Location page.
# Server key: Geocoding API. Restrict it to that API in the Google Cloud console.
google_maps_api_key = ""
# Browser key (optional, defaults to the key above): Maps JavaScript API and Map Tiles API, visible to the
# browser, so restrict it to this app's address (HTTP referrer). A referrer-restricted key cannot be the server key.
google_maps_browser_key = ""

# Model calls on Vertex AI (the agent dock, the mapper's model step). On a laptop nothing is needed here: the app uses
# `gcloud auth application-default login` and the active gcloud project. On Streamlit Community Cloud there is no
# gcloud sign-in, so paste a service account key (role Vertex AI User) into the app's Secrets settings, never into git.
[ai]
project = ""          # optional: defaults to the service account's project
region = "global"     # optional

[ai.service_account]  # the fields of the key's JSON file, as TOML
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""      # keep the \n escapes from the JSON file
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
